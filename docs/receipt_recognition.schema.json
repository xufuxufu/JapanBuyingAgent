{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.japan-buying-agent/schemas/receipt-recognition-1.1.json",
  "title": "Receipt recognition batch import 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipts"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receipt"}}
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "source_page_no", "store", "purchased_at", "receipt_number", "totals", "items", "warnings"],
      "properties": {
        "source_file": {"$ref": "#/$defs/sourceFile"},
        "source_page_no": {"type": "integer", "minimum": 1},
        "store": {"type": "object", "additionalProperties": false, "required": ["raw_name"], "properties": {"raw_name": {"type": "string"}}},
        "purchased_at": {"type": ["string", "null"], "format": "date-time"},
        "receipt_number": {"type": ["string", "null"]},
        "totals": {"$ref": "#/$defs/totals"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sourceFile": {"type": "string", "pattern": "^RCPT-[0-9]{8}-[0-9]{4}-[A-Z0-9]{4}_P[0-9]{2,}\\.jpg$"},
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["subtotal", "discount_total", "tax_total", "paid_total"],
      "properties": {"subtotal": {"type": ["integer", "null"]}, "discount_total": {"type": "integer"}, "tax_total": {"type": ["integer", "null"]}, "paid_total": {"type": ["integer", "null"]}}
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["source_file", "source_page_no", "line_no", "raw_name", "recognized_name", "jan_candidate", "quantity", "unit_price", "discount_amount", "tax_rate", "line_total", "confidence"],
      "properties": {
        "source_file": {"$ref": "#/$defs/sourceFile"}, "source_page_no": {"type": "integer", "minimum": 1},
        "line_no": {"type": "integer", "minimum": 1}, "raw_name": {"type": "string"}, "recognized_name": {"type": ["string", "null"]}, "jan_candidate": {"type": ["string", "null"]},
        "quantity": {"type": "integer", "minimum": 1}, "unit_price": {"type": ["integer", "null"]}, "discount_amount": {"type": "integer"}, "tax_rate": {"type": ["number", "null"]}, "line_total": {"type": ["integer", "null"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
