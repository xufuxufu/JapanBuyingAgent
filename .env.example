# Copy this file to .env for local development. Never commit real credentials.
JBA_DATABASE_URL=
JBA_DEFAULT_ROLE=admin

# Rakuten Product Search (2025-08-01)
JBA_RAKUTEN_APPLICATION_ID=
JBA_RAKUTEN_ACCESS_KEY=
JBA_RAKUTEN_AFFILIATE_ID=
JBA_RAKUTEN_ALLOWED_PUBLIC_IP=14.10.7.65

# Yahoo Shopping v3
JBA_YAHOO_CLIENT_ID=

# QinSi (秦丝) seller portal -- the "去秦丝" shortcut on the price-check page
# links here in a new tab. Leave blank to use the default top-level portal
# domain (its own login guard handles an unauthenticated visitor); override
# only if you use a different QinSi entry URL.
JBA_QINSI_PORTAL_URL=

# Amazon remains SEARCH_ONLY until the API integration is explicitly enabled.
JBA_AMAZON_CREATORS_PUBLIC_KEY=
JBA_AMAZON_CREATORS_PRIVATE_KEY=
JBA_AMAZON_JP_PARTNER_TAG=
JBA_AMAZON_JP_MARKETPLACE=

# Kuaidi100 (快递100) 实时查询 -- 中通 domestic shipment tracking
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_SECRET=

# Domestic shipment tracking automation (Phase 10B). Off by default -- the
# existing manual "立即查询" flow and next_check_at columns work either way.
# Set to true only once KUAIDI100_KEY/KUAIDI100_CUSTOMER above are real and
# you're ready for the app to spend Kuaidi100 quota on its own.
JBA_SHIPMENT_TRACKING_AUTO_ENABLED=false
# How often the background loop checks for due shipments (minutes). This is
# NOT how often any single shipment is re-queried -- that's the existing
# ~2-hour DUE_POLL_INTERVAL in app/shipment_tracking_service.py.
JBA_SHIPMENT_TRACKING_INTERVAL_MINUTES=10
# Quota guard: at most this many shipments queried per background cycle.
JBA_SHIPMENT_TRACKING_MAX_ITEMS=5
